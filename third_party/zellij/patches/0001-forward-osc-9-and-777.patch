+    assert_eq!(osc9.to_canonical_bytes(), b"\x1b]9;x\x07");
+    let osc777 = LegacyDesktopNotification::Osc777Notify {
+        title: "T".to_string(),
+        body: "B".to_string(),
+    };
+    assert_eq!(osc777.to_canonical_bytes(), b"\x1b]777;notify;T;B\x07");
+}
