+#[test]
+fn extracts_focus_events_outside_bracketed_paste() {
+    let mut parser = StdinAnsiParser::new();
+    let out = parser.feed(b"before\x1b[Ibetween\x1b[Oafter");
+
+    assert_eq!(out.residue, b"beforebetweenafter");
+    assert_eq!(
+        out.focus_events,
+        vec![TerminalFocusEvent::Gained, TerminalFocusEvent::Lost]
+    );
+}
+
+#[test]
+fn extracts_fragmented_focus_event() {
+    let mut parser = StdinAnsiParser::new();
+    let first = parser.feed(b"\x1b[");
+    let second = parser.feed(b"I");
+
+    assert!(first.residue.is_empty());
+    assert!(second.residue.is_empty());
+    assert!(first.focus_events.is_empty());
+    assert_eq!(second.focus_events, vec![TerminalFocusEvent::Gained]);
+}
+
+#[test]
+fn preserves_focus_sequences_inside_bracketed_paste() {
+    let mut parser = StdinAnsiParser::new();
+    let pasted = b"\x1b[200~before\x1b[Ibetween\x1b[Oafter\x1b[201~";
+    let out = parser.feed(pasted);
+
+    assert_eq!(out.residue, pasted);
+    assert!(out.focus_events.is_empty());
+}
+
+#[test]
+fn preserves_focus_sequences_inside_fragmented_bracketed_paste() {
+    let mut parser = StdinAnsiParser::new();
+    let first = parser.feed(b"\x1b[20");
+    let second = parser.feed(b"0~before\x1b[I");
+    let third = parser.feed(b"after\x1b[20");
+    let fourth = parser.feed(b"1~");
+
+    let residue = [first.residue, second.residue, third.residue, fourth.residue].concat();
+    assert_eq!(residue, b"\x1b[200~before\x1b[Iafter\x1b[201~");
+    assert!(first.focus_events.is_empty());
+    assert!(second.focus_events.is_empty());
+    assert!(third.focus_events.is_empty());
+    assert!(fourth.focus_events.is_empty());
+}
